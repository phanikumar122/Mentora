# Required by the Docker/production profile. Copy to .env and provide real secrets.
MENTORA_DB_URL=jdbc:mysql://your-database-host:4000/mentora?sslMode=REQUIRED
MENTORA_DB_USER=your_database_user
MENTORA_DB_PASS=replace_with_a_strong_database_password
MENTORA_JWT_SECRET=replace_with_at_least_32_random_characters
MENTORA_CORS_ORIGINS=https://your-frontend-domain.example
VITE_API_URL=https://your-backend-domain.example/api/v1

# Keep disabled when the administrator is provisioned outside application startup.
MENTORA_BOOTSTRAP_ADMIN_ENABLED=false
MENTORA_BOOTSTRAP_ADMIN_EMAIL=admin@mentora.com
MENTORA_BOOTSTRAP_ADMIN_PASSWORD=